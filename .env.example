# Copy to .env (gitignored) and fill in. For offline development you can leave
# the HA_* values blank and set MOCK=true.

# Home Assistant connection (used from Phase 3 onward)
HA_HOST=192.168.1.100:8123
HA_TOKEN=

# HTTP server
PORT=8080

# Modes
MOCK=true   # serve fabricated data instead of connecting to HA
DEV=false   # verbose logging; live template reload (later phases)
# DEBUG_API=  # expose the JSON debug API (/api/*); defaults to DEV. The UI does
              # not use it — leave off on any exposed/LAN instance.

# Home Assistant add-on mode (auto-detected when SUPERVISOR_TOKEN is present):
# ADDON=true reaches HA via the Supervisor proxy (ws://supervisor/core/websocket)
# using SUPERVISOR_TOKEN, so HA_HOST/HA_TOKEN are unused.
# ADDON=false
